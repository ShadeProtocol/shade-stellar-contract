# Reproducible build environment for Shade Protocol Soroban contracts.
# Produces byte-identical .optimized.wasm artifacts across hosts.
FROM rust:1.96.0-slim-bookworm

ARG STELLAR_CLI_VERSION=28.0.0

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    curl \
    git \
    pkg-config \
    libssl-dev \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

RUN rustup target add wasm32v1-none

RUN cargo install --locked stellar-cli --version "${STELLAR_CLI_VERSION}"

ENV TZ=UTC \
    LC_ALL=C \
    SOURCE_DATE_EPOCH=0 \
    CARGO_HOME=/usr/local/cargo \
    RUSTFLAGS="--remap-path-prefix=/workspace=/build --remap-path-prefix=/usr/local/cargo=/cargo"

WORKDIR /workspace

CMD ["bash", "-euo", "pipefail", "-c", "\
    cargo build --locked --target wasm32v1-none --release -p shade -p account && \
    stellar contract optimize --wasm target/wasm32v1-none/release/shade.wasm && \
    stellar contract optimize --wasm target/wasm32v1-none/release/account.wasm && \
    sha256sum target/wasm32v1-none/release/*.optimized.wasm | sort -k2 > target/wasm32v1-none/release/SHA256SUMS && \
    cat target/wasm32v1-none/release/SHA256SUMS \
"]
